---
/**
 * Gear の中身：いま使っている道具のカード（src/content/gear.yaml）。
 * 広告のリンク（sponsored: true）がひとつでもあれば、下に広告の表記を出す。
 */
import { getGear } from '../../lib/content';
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const gear = await getGear();
const hasSponsored = gear.some((g) => g.sponsored);
/** 広い画面での列の数：4 枚までは 1 行に、それより多ければ最後の行が 1 枚だけにならない数 */
const cols = gear.length <= 4 ? gear.length : gear.length % 4 === 1 ? 3 : 4;
/** 日英で同じなら文字のまま、違うならページの言語のほう */
const pick = (v: string | { ja: string; en: string } | undefined) => (typeof v === 'object' ? v[lang] : v) || undefined;
---

<div class="gear" data-field-calm>
  <ul class="cards" style={`--cols:${cols}`}>
    {
      gear.map((g) => {
        const href = pick(g.href);
        const model = pick(g.model);
        const Tag = href ? 'a' : 'div';
        return (
          <li>
            <Tag
              class="card"
              href={href}
              target={href ? '_blank' : undefined}
              rel={href ? (g.sponsored ? 'sponsored noopener' : 'noopener') : undefined}
              data-hover-color={href ? '' : undefined}
            >
              <span class="card__meta">{g.category[lang]}</span>
              <span class="card__title">{pick(g.name)}</span>
              {model && <span class="card__note num">{model}</span>}
              {href && (
                <span class="card__arrow" aria-hidden="true">
                  ↗
                </span>
              )}
            </Tag>
          </li>
        );
      })
    }
  </ul>
  {hasSponsored && <p class="disclosure">{t('gear.disclosure')}</p>}
</div>
