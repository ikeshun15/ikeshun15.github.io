// 小さく描くので、線は少し太めに
const WEIGHT = 2;
const { ink, accent } = drawings[kind];
const strokes = [...ink.map((s) => ({ s, accent: false })), ...accent.map((s) => ({ s, accent: true }))];
---

<svg class:list={['doodle', `doodle--${kind}`, cls]} viewBox="0 10 260 160" aria-hidden="true" data-doodle>
  {
    strokes.map(({ s: [d, w], accent }, i) => (
      <path class={accent ? 'doodle__accent' : 'doodle__ink'} d={d} stroke-width={w * WEIGHT} pathLength="1" style={`--i:${i}`} />
    ))
  }
</svg>

<script>
  // 画面に入ったら描き始める
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-drawn');
        io.unobserve(e.target);
      }),
    { threshold: 0.4 },
  );
  document.querySelectorAll('[data-doodle]').forEach((el) => {
    if (document.documentElement.classList.contains('fx')) el.classList.add('is-ready');
    io.observe(el);
  });
</script>
