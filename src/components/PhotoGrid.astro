---
/** 一覧。写真を切り抜かず、行ごとに高さを揃えて並べる */
import PhotoCard from './PhotoCard.astro';
import type { Photo } from '../lib/photos';
import type { Locale } from '../i18n/ui';

interface Props {
  photos: Photo[];
  lang: Locale;
}
const { photos, lang } = Astro.props;
---

<ul class="pgrid" data-field-source="grid">
  {
    photos.map((p, i) => (
      <li id={`p-${p.slug}`} style={`--ar:${p.ar.toFixed(4)}`}>
        <PhotoCard photo={p} lang={lang} eager={i < 6} sizes="(max-width: 640px) 50vw, 33vw" />
      </li>
    ))
  }
</ul>
