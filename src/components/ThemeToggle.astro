---
/** 昼（太陽）／夜（月）の切り替え。押した位置から円が広がるように切り替わる */
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const t = useTranslations(Astro.props.lang);
---

<button class="themetoggle" type="button" aria-label={t('theme.toggle')} title={t('theme.toggle')} data-theme-toggle>
  <svg class="themetoggle__sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
    <circle cx="10" cy="10" r="3.6"></circle>
    <path d="M10 1.8v2.2M10 16v2.2M1.8 10H4M16 10h2.2M4.2 4.2l1.6 1.6M14.2 14.2l1.6 1.6M4.2 15.8l1.6-1.6M14.2 5.8l1.6-1.6"></path>
  </svg>
  <svg class="themetoggle__moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
    <path d="M16.2 12.4A6.8 6.8 0 0 1 7.6 3.8a6.8 6.8 0 1 0 8.6 8.6z"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const motionOK = () => !matchMedia('(prefers-reduced-motion: reduce)').matches;

  function apply(theme: string) {
    root.dataset.theme = theme;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#0a0a0a' : '#fbfbf9');
    try {
      localStorage.setItem('theme', theme);
    } catch {}
  }

  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    if (!document.startViewTransition || !motionOK()) return apply(next);
    const r = button.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const end = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.classList.add('theme-vt');
    const vt = document.startViewTransition(() => apply(next));
    vt.ready.then(() =>
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${end}px at ${x}px ${y}px)`] },
        { duration: 700, easing: 'cubic-bezier(.7, 0, .2, 1)', pseudoElement: '::view-transition-new(root)' },
      ),
    );
    vt.finished.finally(() => root.classList.remove('theme-vt'));
  });

  // 明示的に選んでいなければ OS の設定に追従
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {}
    if (!stored) root.dataset.theme = e.matches ? 'dark' : 'light';
  });
</script>
