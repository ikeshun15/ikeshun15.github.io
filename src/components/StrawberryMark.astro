---
/**
 * いち(1)ご(5) = 15。イチゴをドットで描いたマーク。
 * 実体は src/lib/strawberry.ts（favicon 生成でも共有）
 */
import { strawberryDots } from '../lib/strawberry';

interface Props {
  size?: number;
  class?: string;
}
const { size = 18, class: cls } = Astro.props;
const { cols, rows, dots } = strawberryDots();
---

<svg
  class:list={['strawberry', cls]}
  width={size}
  height={(size * rows) / cols}
  viewBox={`0 0 ${cols} ${rows}`}
  aria-hidden="true"
>
  {
    dots.map((d) => (
      <circle cx={d.x + 0.5} cy={d.y + 0.5} r="0.42" class={d.leaf ? 'strawberry__leaf' : 'strawberry__berry'} />
    ))
  }
</svg>

<style>
  .strawberry {
    display: block;
    flex: none;
  }
  .strawberry__leaf {
    fill: var(--ink);
  }
  .strawberry__berry {
    fill: var(--accent);
  }
</style>
