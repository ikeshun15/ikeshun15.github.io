---
/**
 * プロフィール（横並び・一覧の、写真の下）。
 * 並び・見出し・表示するかどうかは src/content/sections.yaml で決める（src/lib/content.ts の getSections）。
 * どのセクションも「手描きの線画 → 見出し → 小さな日本語（日本語のページだけ）→ ひとこと」を中央にそろえ、
 * その下に中身を置く。中身は src/components/sections/ の部品が、src/content/*.yaml から作る。
 * 写真の下までスクロールすると、写真が化けたドットがこの後ろに散らばる（data-field-target、src/lib/field.ts）
 */
import Doodle from './Doodle.astro';
import AboutBody from './sections/AboutBody.astro';
import HistoryBody from './sections/HistoryBody.astro';
import GearBody from './sections/GearBody.astro';
import { getSections } from '../lib/content';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const sections = await getSections();
const bodies = { about: AboutBody, history: HistoryBody, gear: GearBody };
---

<div class="profile" data-field-target>
  {
    sections.map((s) => {
      const Body = bodies[s.id];
      return (
        <section class="sect" id={s.id} aria-labelledby={`${s.id}-title`} data-section>
          <header class="sect__head" data-field-calm>
            {s.doodle && <Doodle kind={s.doodle} class="sect__doodle" />}
            <h2 class="display" id={`${s.id}-title`}>
              {s.title}
            </h2>
            {lang === 'ja' && s.sub && <p class="display-sub">{s.sub}</p>}
            {s.lead && <p class="sect__lead">{s.lead[lang]}</p>}
          </header>
          <Body lang={lang} />
        </section>
      );
    })
  }
</div>

<script>
  // いま画面の中央にあるセクションを、メニューの現在地にする（どれでもなければ写真）
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  const visible = new Set<string>();
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
      const current = [...sections].reverse().find((el) => visible.has(el.id))?.id ?? 'photos';
      navLinks.forEach((a) =>
        a.dataset.nav === current ? a.setAttribute('aria-current', 'page') : a.removeAttribute('aria-current'),
      );
    },
    { rootMargin: '-50% 0px -50% 0px' },
  );
  sections.forEach((el) => spy.observe(el));

  // 重なった写真が広がる／あゆみの節が光る（画面に入ったとき）
  const reveal = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        reveal.unobserve(e.target);
      }),
    { rootMargin: '0px 0px -20% 0px' },
  );
  document.querySelectorAll('[data-stack], [data-timeline-item]').forEach((el) => reveal.observe(el));
</script>
