---
/**
 * 写真1枚。横並びでは高さ（--card-h）から幅が決まり、一枚ずつ・一覧では幅いっぱいに広がる。
 */
import { Image } from 'astro:assets';
import { photoTitle, type Photo } from '../lib/photos';
import { localePath, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  photo: Photo;
  lang: Locale;
  /** 表示幅の目安（img の sizes） */
  sizes: string;
  eager?: boolean;
}
const { photo, lang, sizes, eager = false } = Astro.props;
const t = useTranslations(lang);
const title = photoTitle(photo, lang) || t('photo.untitled');
---

<figure class="pcard" data-slug={photo.slug} data-accent={photo.accent ?? undefined} style={`--ar:${photo.ar.toFixed(4)};--c:${photo.color}`}>
  <a class="pcard__link" href={localePath(lang, `/photos/${photo.slug}/`)} aria-label={title}>
    <Image
      src={photo.image}
      widths={[480, 800, 1200, 1800]}
      sizes={sizes}
      format="webp"
      quality={80}
      alt={title}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="pcard__img"
      style={`view-transition-name: photo-${photo.slug}`}
    />
  </a>
</figure>
