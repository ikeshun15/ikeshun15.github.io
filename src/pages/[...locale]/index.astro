---
import Base from '../../layouts/Base.astro';
import PhotoStrip from '../../components/PhotoStrip.astro';
import Profile from '../../components/Profile.astro';
import { getFeaturedPhotos } from '../../lib/photos';
import { localeStaticPaths, type Locale } from '../../i18n/ui';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
const photos = await getFeaturedPhotos(24);
---

<Base lang={lang} path="/">
  <h1 class="visually-hidden">Shun15</h1>
  <PhotoStrip photos={photos} lang={lang} />
  <Profile lang={lang} />
</Base>
