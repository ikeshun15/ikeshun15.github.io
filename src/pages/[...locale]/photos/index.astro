---
import Base from '../../../layouts/Base.astro';
import PhotoGrid from '../../../components/PhotoGrid.astro';
import Profile from '../../../components/Profile.astro';
import ViewToggle from '../../../components/ViewToggle.astro';
import { getPhotos } from '../../../lib/photos';
import { localeStaticPaths, useTranslations, type Locale } from '../../../i18n/ui';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
const photos = await getPhotos();
---

<Base lang={lang} path="/photos/" title={t('photos.title')}>
  <h1 class="visually-hidden">{t('photos.title')}</h1>
  <div class="viewpage">
    <div class="viewbar">
      <ViewToggle lang={lang} current="grid" />
    </div>
    {photos.length ? <PhotoGrid photos={photos} lang={lang} /> : <p class="empty">{t('photos.empty')}</p>}
  </div>
  <Profile lang={lang} />
</Base>
