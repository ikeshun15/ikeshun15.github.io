---
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { exifLine, getPhotos, photoTitle } from '../../../lib/photos';
import { localePath, localeStaticPaths, useTranslations, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const photos = await getPhotos();
  return localeStaticPaths().flatMap(({ params, props }) =>
    photos.map((p, index) => ({
      params: { ...params, slug: p.slug },
      props: { lang: props.lang, index },
    })),
  );
}

const { lang, index } = Astro.props as { lang: Locale; index: number };
const t = useTranslations(lang);
const photos = await getPhotos();
const photo = photos[index];
const prev = photos[index - 1];
const next = photos[index + 1];

const title = photoTitle(photo, lang);
const href = (slug: string) => localePath(lang, `/photos/${slug}/`);
const closeHref = `${localePath(lang, '/photos/')}#p-${photo.slug}`;
const meta = [photo.date, exifLine(photo.exif)].filter(Boolean).join(' · ');

const og = await getImage({ src: photo.image, width: 1200, format: 'jpg', quality: 80 });
---

<Base lang={lang} path={`/photos/${photo.slug}/`} title={title || t('photos.title')} image={og.src}>
  <article
    class="viewer"
    data-viewer
    data-slug={photo.slug}
    data-accent={photo.accent ?? undefined}
    data-prev={prev ? href(prev.slug) : undefined}
    data-next={next ? href(next.slug) : undefined}
    data-close-href={closeHref}
  >
    <div class="viewer__stage" data-viewer-stage data-field-source="still">
      <Image
        src={photo.image}
        widths={[800, 1280, 1920, 2560]}
        sizes="(max-width: 640px) 100vw, 86vw"
        format="webp"
        quality={82}
        alt={title || t('photo.untitled')}
        loading="eager"
        fetchpriority="high"
        class="viewer__img"
        style={`--ar:${photo.ar.toFixed(4)};--c:${photo.color};view-transition-name: photo-${photo.slug}`}
      />
    </div>

    <div class="viewer__bar">
      <div class="viewer__meta">
        {title && <h1 class="viewer__title serif">{title}</h1>}
        {meta && <p class="viewer__sub">{meta}</p>}
      </div>
      <nav class="viewer__nav" aria-label="Photo navigation">
        <a href={prev ? href(prev.slug) : undefined} aria-disabled={prev ? undefined : 'true'} aria-label={t('photo.prev')} rel="prev">←</a>
        <a href={closeHref} aria-label={t('photo.close')} data-close>✕</a>
        <a href={next ? href(next.slug) : undefined} aria-disabled={next ? undefined : 'true'} aria-label={t('photo.next')} rel="next">→</a>
      </nav>
    </div>
  </article>
</Base>

<script>
  const viewer = document.querySelector<HTMLElement>('[data-viewer]');
  const go = (url?: string) => {
    if (url) location.href = url;
  };

  // 横並び・一覧から開いたときは「戻る」で閉じる（スクロール位置もそのまま戻る）
  const close = () => {
    const ref = document.referrer.startsWith(location.origin) ? new URL(document.referrer).pathname : '';
    if (/^\/(en\/)?(photos\/)?$/.test(ref) && history.length > 1) history.back();
    else go(viewer?.dataset.closeHref);
  };
  document.querySelector('a[data-close]')?.addEventListener('click', (e) => {
    // 新しいタブで開く操作（Ctrl／⌘＋クリックなど）は、ブラウザに任せる
    const m = e as MouseEvent;
    if (m.button !== 0 || m.metaKey || m.ctrlKey || m.shiftKey || m.altKey) return;
    e.preventDefault();
    close();
  });

  addEventListener('keydown', (e) => {
    if (!viewer || e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
    // メニューを開いている間のキー操作はメニューのもの（Esc はメニューを閉じるだけ）。
    // メニュー側が先に閉じてしまう前に判断できるよう、このリスナーは先に（capture で）受け取る
    if (document.documentElement.classList.contains('menu-open')) return;
    if (e.key === 'ArrowLeft') go(viewer.dataset.prev);
    else if (e.key === 'ArrowRight') go(viewer.dataset.next);
    else if (e.key === 'Escape') close();
  }, true);

  // スマホ：左右スワイプで前後の写真へ
  const stage = document.querySelector<HTMLElement>('[data-viewer-stage]');
  let sx = 0;
  let sy = 0;
  stage?.addEventListener(
    'touchstart',
    (e) => {
      sx = e.touches[0].clientX;
      sy = e.touches[0].clientY;
    },
    { passive: true },
  );
  stage?.addEventListener('touchend', (e) => {
    if (!viewer) return;
    const dx = e.changedTouches[0].clientX - sx;
    const dy = e.changedTouches[0].clientY - sy;
    if (Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
    go(dx < 0 ? viewer.dataset.next : viewer.dataset.prev);
  });
</script>
