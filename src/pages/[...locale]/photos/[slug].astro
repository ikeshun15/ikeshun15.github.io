---
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { getPhotos, photoTitle } from '../../../lib/photos';
import { localePath, localeStaticPaths, useTranslations, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const photos = await getPhotos();
  return localeStaticPaths().flatMap(({ params, props }) =>
    photos.map((p, index) => ({
      params: { ...params, slug: p.slug },
      props: { lang: props.lang, index },
    })),
  );
}

const { lang, index } = Astro.props as { lang: Locale; index: number };
const t = useTranslations(lang);
const photos = await getPhotos();
const photo = photos[index];
const prev = photos[index - 1];
const next = photos[index + 1];

const title = photoTitle(photo, lang);
const num = (i: number) => String(i + 1).padStart(3, '0');
const href = (slug: string) => localePath(lang, `/photos/${slug}/`);
const closeHref = `${localePath(lang, '/photos/')}#p-${photo.slug}`;

const exifRows = [
  ['Camera', photo.exif.camera],
  ['Lens', photo.exif.lens],
  ['Focal', photo.exif.focal],
  ['Aperture', photo.exif.aperture],
  ['Shutter', photo.exif.shutter],
  ['ISO', photo.exif.iso?.replace(/^ISO /, '')],
  ['Date', photo.date],
].filter((r): r is [string, string] => Boolean(r[1]));

const og = await getImage({ src: photo.image, width: 1200, format: 'jpg', quality: 80 });
---

<Base
  lang={lang}
  path={`/photos/${photo.slug}/`}
  title={title || `${t('photos.title')} ${num(index)}`}
  image={og.src}
>
  <article
    class="viewer"
    data-viewer
    data-prev={prev ? href(prev.slug) : undefined}
    data-next={next ? href(next.slug) : undefined}
    data-close={closeHref}
  >
    <div class="viewer__stage" data-viewer-stage>
      <Image
        src={photo.image}
        widths={[800, 1280, 1920, 2560]}
        sizes="(max-width: 640px) 100vw, 86vw"
        format="webp"
        quality={82}
        alt={title || `${t('photo.untitled')} ${num(index)}`}
        loading="eager"
        fetchpriority="high"
        class="viewer__img"
        style={`--ar:${photo.ar.toFixed(4)};--c:${photo.color};view-transition-name: photo-${photo.slug}`}
      />
    </div>

    <div class="viewer__bar">
      <div class="viewer__meta">
        <span class="viewer__index mono">{num(index)} / {String(photos.length).padStart(3, '0')}</span>
        {title && <h1 class="viewer__title">{title}</h1>}
      </div>

      <nav class="viewer__nav" aria-label="Photo navigation">
        <a
          class="icon-btn"
          href={prev ? href(prev.slug) : undefined}
          aria-label={t('photo.prev')}
          aria-disabled={prev ? undefined : 'true'}
          rel="prev">←</a
        >
        <a class="icon-btn" href={closeHref} aria-label={t('photo.close')}>✕</a>
        <a
          class="icon-btn"
          href={next ? href(next.slug) : undefined}
          aria-label={t('photo.next')}
          aria-disabled={next ? undefined : 'true'}
          rel="next">→</a
        >
      </nav>

      {
        exifRows.length > 0 && (
          <dl class="viewer__exif mono">
            {exifRows.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </article>
</Base>

<script>
  const viewer = document.querySelector<HTMLElement>('[data-viewer]');
  const go = (url?: string) => {
    if (url) location.href = url;
  };

  addEventListener('keydown', (e) => {
    if (!viewer || e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
    if (e.key === 'ArrowLeft') go(viewer.dataset.prev);
    else if (e.key === 'ArrowRight') go(viewer.dataset.next);
    else if (e.key === 'Escape') go(viewer.dataset.close);
  });

  // スマホ：左右スワイプで前後の写真へ
  const stage = document.querySelector<HTMLElement>('[data-viewer-stage]');
  let sx = 0;
  let sy = 0;
  stage?.addEventListener(
    'touchstart',
    (e) => {
      sx = e.touches[0].clientX;
      sy = e.touches[0].clientY;
    },
    { passive: true },
  );
  stage?.addEventListener('touchend', (e) => {
    if (!viewer) return;
    const dx = e.changedTouches[0].clientX - sx;
    const dy = e.changedTouches[0].clientY - sy;
    if (Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
    go(dx < 0 ? viewer.dataset.next : viewer.dataset.prev);
  });
</script>
