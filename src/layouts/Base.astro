---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/noto-sans-jp';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/shippori-mincho/400.css';
import '@fontsource/shippori-mincho/500.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { getDotColors } from '../lib/photos';
import { localePath, locales, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  /** 言語プレフィックスを除いたパス（例: "/photos/"） */
  path: string;
  title?: string;
  description?: string;
  /** OGP 画像の絶対 URL かルート相対パス */
  image?: string;
  /** 404 など、言語切り替えの対象にしないページ */
  noAlternates?: boolean;
}

const { lang, path, title, description, image = '/og.png', noAlternates = false } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} — ${site.name}` : site.name;
const desc = description ?? t('meta.description');
const canonical = new URL(localePath(lang, path), site.url).href;
const ogImage = new URL(image, site.url).href;
const gaId = site.gaMeasurementId;

// ドットの色：登録してあるすべての写真から選んだ色（src/lib/field.ts が使う）
const dots = await getDotColors(45);
---

<!doctype html>
<html lang={lang} id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {
      !noAlternates &&
        locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), site.url).href} />)
    }
    {!noAlternates && <link rel="alternate" hreflang="x-default" href={new URL(localePath('ja', path), site.url).href} />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fbfbf9" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // 描画前にテーマを確定してちらつきを防ぐ。動きを減らす設定でなければ粒子の演出を有効にする
      (function () {
        var root = document.documentElement;
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var theme = stored || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        root.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').setAttribute('content', theme === 'dark' ? '#0a0a0a' : '#fbfbf9');
        var motionOK = !matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (motionOK) root.classList.add('fx');

        // 読み込み中のドットは、直接開いたとき・リロードしたときに毎回出す。
        // サイト内のリンク移動と「戻る／進む」では出さない（ページ切り替えのたびに待たせないため）。
        // 進行は src/lib/field.ts が受け持つ。スクリプトが動かなかったときのために、10 秒で必ず解除する
        var entry = performance.getEntriesByType ? performance.getEntriesByType('navigation')[0] : null;
        var type = entry ? entry.type : 'navigate';
        var internal = document.referrer.indexOf(location.origin + '/') === 0;
        var show = motionOK && type !== 'back_forward' && (type === 'reload' || !internal);
        if (!show) return;
        root.classList.add('is-loading');
        setTimeout(function () {
          root.classList.remove('is-loading', 'is-loaded');
        }, 10000);
      })();
    </script>

    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
  </head>
  <body data-dots={dots}>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header lang={lang} path={path} noAlternates={noAlternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // 写真とドットの演出（読み込み中のドット・写真の下のドットの背景）
      import { mountField } from '../lib/field';
      mountField();
    </script>
  </body>
</html>
